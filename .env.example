# Supabase
SUPABASE_URL=https://qcfvijgruitljvjrbguh.supabase.co
SUPABASE_ANON_KEY=
# Required for /api/auth/register (admin.create_user) and backend job runner
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Auth notes:
# - UI uses nickname + password only (no email)
# - Internally maps to {nickname}@autoheart.com
# - In Supabase Dashboard → Auth → turn OFF "Confirm email" for smoother signup

# TrueMoney merchant phone (digits only)
TRUEWALLET_PHONE=

# AES key for encrypting DevPlay passwords (any long secret; hashed to 32 bytes)
CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Redis (optional for future rate-limit/queue cache)
REDIS_URL=redis://localhost:6379/0

# Cookie Run client version the bot claims when it enters the game.
# The game server answers responseCode 364 "LOW CLIENT VERSION" once the live
# build moves past it, so after a game update set these to the version and
# build code Google Play lists for com.devsisters.crg. Empty = use the
# defaults compiled into backend/heart_farm/heart_farm.py.
CRK_APP_VERSION=
CRK_APP_BUILD=
# Live asset combo the gRPC calls announce; only touch these if the game
# starts rejecting calls after a version bump alone.
CRK_COMBO_NAME=
CRK_INDEX_HASH=

# App identity sent to the LOGIN server (account.devplay.com), as opposed to the
# game-version values above. Symptom that these have gone stale: guest creation
# fails with HTTP 200, a non-20000 code and an empty token, and keeps failing
# through every retry -- each retry already rotates the device id, the whole lc
# fingerprint and (behind a rotating proxy) the exit IP, so a refusal that
# survives all of them is about these values rather than the network. Re-capture
# them from a HAR of the live client. Empty = use the defaults in
# backend/heart_farm/heart_farm.py.
CRK_API_KEY=
CRK_SDK_VERSION=
CRK_LIBRARY_VERSION=
CRK_LIBRARY_NAME=
CRK_USER_AGENT=
CRK_BUNDLE_ID=
CRK_ENV=
CRK_AUTH_HOST=

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
HEARTS_PER_MINUTE=50
# ว่างไว้ = ใช้ล่ามตัวเดียวกับที่รัน API (venv / คอนเทนเนอร์)
# ตั้งเฉพาะเมื่อจงใจใช้ล่ามคนละตัว และล่ามนั้นลง requirements.txt ครบแล้ว
PYTHON_BIN=

# Operations / worker reliability (leave Telegram values empty to disable delivery)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WORKER_STUCK_TIMEOUT_SECONDS=180
WORKER_WATCHDOG_INTERVAL_SECONDS=15
WORKER_RETRY_BASE_DELAY_SECONDS=30
WORKER_RETRY_MAX_ATTEMPTS=3
TELEGRAM_ALERT_COOLDOWN_SECONDS=300

# Frontend (also copy to frontend/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://qcfvijgruitljvjrbguh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
