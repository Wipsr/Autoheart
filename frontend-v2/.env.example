# ทั้ง 4 ตัวต้องมีครบ ไม่งั้น build ล้มตั้งแต่ prerender
# (ดูข้อความที่ src/lib/supabase/env.ts โยนออกมา — มันบอกชื่อตัวที่ขาดให้)
#
# บน Vercel: Settings → Environment Variables ของโปรเจกต์ที่ Root Directory
# ชี้มาที่ frontend-v2 เท่านั้น — repo นี้มี frontend สองตัวคนละโปรเจกต์
# ชื่อใกล้กัน (autoheart / autoheart-v2) ใส่ผิดตัวแล้ว build จะฟ้องว่าไม่เจอ env
# และอย่าลืมติ๊ก Production ให้ครบ (Preview ด้วยถ้าอยากให้ branch deploy ผ่าน)

NEXT_PUBLIC_SUPABASE_URL=https://qcfvijgruitljvjrbguh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ตอน dev ให้ชี้ไป backend บน Railway — อย่ารัน backend ที่เครื่องคู่ไปด้วย
# มันจะไปแย่งคิว jobs เดียวกันกับ production (Supabase project เดียวกัน)
# แล้วสั่ง fail งานที่ Railway กำลังทำสำเร็จอยู่ ดูหัวข้อ "Dev workflow" ใน README
NEXT_PUBLIC_API_URL=https://autoheart-production.up.railway.app
NEXT_PUBLIC_WS_URL=wss://autoheart-production.up.railway.app

# หมายเหตุเรื่อง CORS: โดเมนที่เปิดหน้าเว็บจริงต้องอยู่ใน CORS_ORIGINS ฝั่ง
# Railway ด้วย ไม่งั้นหน้าเว็บโหลดขึ้นแต่ยิง API ไม่ได้สักเส้น
